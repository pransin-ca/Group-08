<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".ProfileEditor">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="373dp"
        android:layout_height="92dp"
        android:fontFamily="@font/baloo_da"
        android:text="Edit Name"
        android:textAlignment="viewStart"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="7dp"
        tools:layout_editor_absoluteY="390dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="373dp"
        android:layout_height="92dp"
        android:layout_marginBottom="340dp"
        android:fontFamily="@font/baloo_da"
        android:text="Edit Profile Picture"
        android:textAlignment="center"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.578"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="373dp"
        android:layout_height="92dp"
        android:fontFamily="@font/baloo_da"
        android:text="Edit username"
        android:textAlignment="viewStart"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="7dp"
        tools:layout_editor_absoluteY="500dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="373dp"
        android:layout_height="92dp"
        android:fontFamily="@font/baloo_da"
        android:text="Edit password"
        android:textAlignment="viewStart"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="7dp"
        tools:layout_editor_absoluteY="613dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="299dp"
        android:layout_height="261dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/EmptyProfilePicture" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="133dp"
        android:layout_height="121dp"
        app:srcCompat="@drawable/ClassFlowLogo"
        tools:layout_editor_absoluteX="-19dp"
        tools:layout_editor_absoluteY="-13dp" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="48dp"
        android:layout_height="46dp"
        app:srcCompat="@drawable/b7ef65c128c17b5cb6d60fd0a09a6983ca396881"
        tools:layout_editor_absoluteX="347dp"
        tools:layout_editor_absoluteY="16dp" />

    <EditText
        android:id="@+id/editTextTime"
        android:layout_width="85dp"
        android:layout_height="39dp"
        android:ems="10"
        android:inputType="time"
        android:text="12:00 PM"
        tools:layout_editor_absoluteX="322dp"
        tools:layout_editor_absoluteY="108dp" />

</androidx.constraintlayout.widget.ConstraintLayout>