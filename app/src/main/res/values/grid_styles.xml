<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GridCell">
        <item name="android:background">@drawable/grid_border</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#212121</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="GridLabel" parent="GridCell">
        <item name="android:minWidth">96dp</item>
    </style>

    <style name="GridInput" parent="GridCell">
        <item name="android:inputType">numberDecimal</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:ems">3</item>
        <item name="android:imeOptions">actionNext</item>
    </style>

    <style name="GridAvg" parent="GridCell">
        <item name="android:background">@drawable/grid_border_avg</item>
    </style>

    <style name="GridGeneral" parent="GridCell">
        <item name="android:background">@drawable/grid_border_general</item>
    </style>
</resources>