<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".Login">

    <TextView
        android:id="@+id/classflowWordmark"
        android:layout_width="135dp"
        android:layout_height="31dp"
        android:text="ClassFlow"
        android:textColor="#804000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.058" />

    <ImageView
        android:id="@+id/classflowLogo"
        android:layout_width="116dp"
        android:layout_height="120dp"
        android:src="@drawable/classflow_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/loginBoxGreeting"
        android:layout_width="349dp"
        android:layout_height="245dp"
        android:background="@drawable/custom_square"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.168" />

    <ImageView
        android:id="@+id/emptyPfpLogin"
        android:layout_width="162dp"
        android:layout_height="161dp"
        android:src="@drawable/empty_profile_picture"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.083" />

    <TextView
        android:id="@+id/loginGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME BACK!"
        android:textColor="#FFD59B"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.77" />

    <TextView
        android:id="@+id/dontHaveAnAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account?"
        android:textColor="#D9AF85"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.323"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.84" />

    <TextView
        android:id="@+id/signUpRedirect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Sign up."
        android:textColor="#FFFFFF"
        android:textColorLink="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.708"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.836" />

    <TextView
        android:id="@+id/userTypeLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="404dp"
        android:layout_marginEnd="72dp"
        android:text="User Type (Type STUDENT or TEACHER. All caps)"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/nameInputFieldLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/nameInputFieldLogin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/studentIDLogin"
        android:layout_width="209dp"
        android:layout_height="25dp"
        android:layout_marginTop="512dp"
        android:layout_marginEnd="172dp"
        android:layout_marginBottom="3dp"
        android:text="Student ID (If teacher, put email.)"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/studentIDInputLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/studentIDInputLogin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/passwordLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="524dp"
        android:layout_marginEnd="284dp"
        android:layout_marginBottom="3dp"
        android:text="Enter password"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/passwordInputLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/passwordInputLogin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="121dp"
        android:layout_height="50dp"
        android:backgroundTint="#654621"
        android:text="LOG IN"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.933" />

    <EditText
        android:id="@+id/nameInputFieldLogin"
        android:layout_width="319dp"
        android:layout_height="wrap_content"
        android:autofillHints="name"
        android:ems="10"
        android:hint="Name"
        android:inputType="text"
        android:minHeight="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.326"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.516" />

    <EditText
        android:id="@+id/passwordInputLogin"
        android:layout_width="314dp"
        android:layout_height="53dp"
        android:autofillHints="password"
        android:ems="10"
        android:hint="Password"
        android:inputType="number"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.319"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.793" />

    <EditText
        android:id="@+id/studentIDInputLogin"
        android:layout_width="318dp"
        android:layout_height="52dp"
        android:autofillHints="emailAddress"
        android:ems="10"
        android:hint="Student ID (or email)"
        android:inputType="textPassword"
        android:minHeight="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.333"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.647" />

</androidx.constraintlayout.widget.ConstraintLayout>