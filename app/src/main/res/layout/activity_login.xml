<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".LoginActivity">

    <TextView
        android:id="@+id/textView8"
        android:layout_width="334dp"
        android:layout_height="43dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/custom_shape"
        android:backgroundTint="#D9AF85"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        tools:layout_editor_absoluteY="424dp" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="325dp"
        android:layout_height="227dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/custom_shape"
        android:backgroundTint="#684624"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="83dp"
        android:layout_height="110dp"
        app:srcCompat="@mipmap/classflow_logo_foreground"
        tools:layout_editor_absoluteX="9dp"
        tools:layout_editor_absoluteY="-13dp" />

    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#00FFFFFF"
        android:fontFamily="@font/fredoka_one"
        android:foregroundTint="#543838"
        android:text="ClassFlow"
        android:textColor="#684624"
        android:textSize="16sp"
        tools:layout_editor_absoluteX="70dp"
        tools:layout_editor_absoluteY="34dp" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="163dp"
        android:layout_height="174dp"
        app:srcCompat="@mipmap/userprofileblank_foreground"
        tools:layout_editor_absoluteX="124dp"
        tools:layout_editor_absoluteY="73dp" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka_one"
        android:text="WELCOME BACK!"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#FFD59B"
        android:textSize="34sp"
        tools:layout_editor_absoluteX="63dp"
        tools:layout_editor_absoluteY="228dp" />

    <TextView
        android:id="@+id/textView9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka_one"
        android:text="Don't have an account?"
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#FFD59B"
        android:textSize="14sp"
        tools:layout_editor_absoluteX="92dp"
        tools:layout_editor_absoluteY="263dp" />

    <TextView
        android:id="@+id/textView18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/fredoka_one"
        android:text=" Sign up."
        android:textAppearance="@style/TextAppearance.AppCompat.Body2"
        android:textColor="#FFD59B"
        android:textSize="14sp"
        tools:layout_editor_absoluteX="249dp"
        tools:layout_editor_absoluteY="263dp" />

    <Button
        android:id="@+id/button3"
        android:layout_width="54dp"
        android:layout_height="22dp"
        android:text="Button"
        android:visibility="invisible"
        tools:layout_editor_absoluteX="251dp"
        tools:layout_editor_absoluteY="263dp" />

</androidx.constraintlayout.widget.ConstraintLayout>

