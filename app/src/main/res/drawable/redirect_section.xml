<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"> <!-- Can be rectangle, oval, line, or ring -->

    <!-- Inner background color -->
    <solid android:color="#EE6B6E" />

    <!-- Border/Outline -->
    <stroke
        android:width="3dp"
        android:color="#33080B" />

    <!-- Rounded corners -->
    <corners android:radius="20dp" />

</shape>