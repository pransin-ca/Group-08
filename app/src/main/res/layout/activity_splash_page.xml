<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".SplashPage">

    <ImageView
        android:id="@+id/classflowLogo"
        android:layout_width="363dp"
        android:layout_height="341dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.341"
        app:srcCompat="@drawable/classflow_logo" />

    <TextView
        android:id="@+id/classflowWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ClassFlow"
        android:textColor="#804000"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="@+id/classflowLogo"
        app:layout_constraintEnd_toEndOf="@+id/classflowLogo"
        app:layout_constraintStart_toStartOf="@+id/classflowLogo"
        app:layout_constraintTop_toTopOf="@+id/classflowLogo"
        app:layout_constraintVertical_bias="0.815" />
</androidx.constraintlayout.widget.ConstraintLayout>