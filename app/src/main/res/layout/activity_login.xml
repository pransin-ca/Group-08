<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".Login">

    <TextView
        android:id="@+id/userTypeLoginField"
        android:layout_width="373dp"
        android:layout_height="62dp"
        android:background="@drawable/custom_rounded_square"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.499" />

    <TextView
        android:id="@+id/studentIDLoginField"
        android:layout_width="373dp"
        android:layout_height="62dp"
        android:background="@drawable/custom_rounded_square"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.647" />

    <TextView
        android:id="@+id/passwordLoginField"
        android:layout_width="373dp"
        android:layout_height="62dp"
        android:background="@drawable/custom_rounded_square"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.802" />

    <TextView
        android:id="@+id/classflowWordmark"
        android:layout_width="135dp"
        android:layout_height="31dp"
        android:text="ClassFlow"
        android:textColor="#804000"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.058" />

    <ImageView
        android:id="@+id/classflowLogo"
        android:layout_width="116dp"
        android:layout_height="120dp"
        android:src="@drawable/classflow_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/loginBoxGreeting"
        android:layout_width="349dp"
        android:layout_height="245dp"
        android:background="@drawable/custom_square"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.158" />

    <ImageView
        android:id="@+id/emptyPfpLogin"
        android:layout_width="162dp"
        android:layout_height="161dp"
        android:src="@drawable/empty_profile_picture"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.083" />

    <TextView
        android:id="@+id/loginGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME BACK!"
        android:textColor="#FFD59B"
        android:textSize="34sp"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.77" />

    <TextView
        android:id="@+id/dontHaveAnAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Don't have an account?"
        android:textColor="#D9AF85"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.323"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.84" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Sign up."
        android:textColor="#FFFFFF"
        android:textColorLink="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/loginBoxGreeting"
        app:layout_constraintEnd_toEndOf="@+id/loginBoxGreeting"
        app:layout_constraintHorizontal_bias="0.708"
        app:layout_constraintStart_toStartOf="@+id/loginBoxGreeting"
        app:layout_constraintTop_toTopOf="@+id/loginBoxGreeting"
        app:layout_constraintVertical_bias="0.836" />

    <TextView
        android:id="@+id/userTypeLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Type (Type STUDENT or TEACHER. All caps)"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/userTypeLoginField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/userTypeLoginField"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.982" />

    <TextView
        android:id="@+id/studentIDLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student ID (If teacher, put email.)"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/studentIDLoginField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/studentIDLoginField"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.984" />

    <TextView
        android:id="@+id/passwordLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Enter password"
        android:textColor="#804000"
        app:layout_constraintBottom_toTopOf="@+id/passwordLoginField"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/passwordLoginField"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/loginButton"
        android:layout_width="121dp"
        android:layout_height="50dp"
        android:backgroundTint="#654621"
        android:text="LOG IN"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.939" />

    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Name"
        app:layout_constraintBottom_toBottomOf="@+id/userTypeLoginField"
        app:layout_constraintEnd_toEndOf="@+id/userTypeLoginField"
        app:layout_constraintHorizontal_bias="0.073"
        app:layout_constraintStart_toStartOf="@+id/userTypeLoginField"
        app:layout_constraintTop_toTopOf="@+id/userTypeLoginField"
        app:layout_constraintVertical_bias="0.529" />

    <EditText
        android:id="@+id/editTextNumber4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        app:layout_constraintBottom_toBottomOf="@+id/studentIDLoginField"
        app:layout_constraintEnd_toEndOf="@+id/studentIDLoginField"
        app:layout_constraintHorizontal_bias="0.073"
        app:layout_constraintStart_toStartOf="@+id/studentIDLoginField"
        app:layout_constraintTop_toTopOf="@+id/studentIDLoginField"
        app:layout_constraintVertical_bias="0.529" />

    <EditText
        android:id="@+id/editTextTextPassword5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPassword"
        app:layout_constraintBottom_toBottomOf="@+id/passwordLoginField"
        app:layout_constraintEnd_toEndOf="@+id/passwordLoginField"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toStartOf="@+id/passwordLoginField"
        app:layout_constraintTop_toTopOf="@+id/passwordLoginField"
        app:layout_constraintVertical_bias="0.47" />

</androidx.constraintlayout.widget.ConstraintLayout>