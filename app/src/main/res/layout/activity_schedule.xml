<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFD59B"
    tools:context=".Schedule">

    <!-- Top Profile & Header -->

    <ImageView
        android:id="@+id/classflowLogo3"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:contentDescription="ClassFlow Logo"
        android:src="@drawable/classflow_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dateView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:text="MON, OCT. 19"
        android:textColor="#804000"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@+id/classflowLogo3"
        app:layout_constraintTop_toTopOf="@+id/classflowLogo3" />

    <ImageView
        android:id="@+id/emptyPfpLogin5"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Profile Picture"
        android:src="@drawable/empty_profile_picture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/classflowLogo3" />

    <ImageView
        android:id="@+id/notificationIcon4"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Notifications"
        android:src="@drawable/notification_icon"
        app:layout_constraintEnd_toStartOf="@+id/emptyPfpLogin5"
        app:layout_constraintTop_toTopOf="@+id/emptyPfpLogin5" />

    <!-- Class Title -->

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFamily="sans-serif-black"
        android:text="11 - ST. CARLO ACUTIS"
        android:textColor="#804000"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/classflowLogo3" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCHEDULE"
        android:textColor="#804000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView4" />

    <!-- Date Selector Cards -->
    <TextView
        android:id="@+id/dateBackground"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/custom_rounded_square"
        app:layout_constraintEnd_toStartOf="@+id/dateBackground2"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="18"
        android:textColor="#804000"
        android:textSize="36sp"
        app:layout_constraintBottom_toTopOf="@+id/dateName1"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground"
        app:layout_constraintStart_toStartOf="@+id/dateBackground"
        app:layout_constraintTop_toTopOf="@+id/dateBackground"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/dateName1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SUN"
        android:textColor="#804000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/dateBackground"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground"
        app:layout_constraintStart_toStartOf="@+id/dateBackground"
        app:layout_constraintTop_toBottomOf="@+id/date" />

    <TextView
        android:id="@+id/dateBackground2"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:background="@drawable/custom_rs_3"
        app:layout_constraintEnd_toStartOf="@+id/dateBackground3"
        app:layout_constraintStart_toEndOf="@+id/dateBackground"
        app:layout_constraintTop_toTopOf="@+id/dateBackground" />

    <TextView
        android:id="@+id/date2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="19"
        android:textColor="#804000"
        android:textSize="36sp"
        app:layout_constraintBottom_toTopOf="@+id/dateName2"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground2"
        app:layout_constraintStart_toStartOf="@+id/dateBackground2"
        app:layout_constraintTop_toTopOf="@+id/dateBackground2"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/dateName2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MON"
        android:textColor="#804000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/dateBackground2"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground2"
        app:layout_constraintStart_toStartOf="@+id/dateBackground2"
        app:layout_constraintTop_toBottomOf="@+id/date2" />

    <TextView
        android:id="@+id/dateBackground3"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/custom_rounded_square"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/dateBackground2"
        app:layout_constraintTop_toTopOf="@+id/dateBackground" />

    <TextView
        android:id="@+id/date3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="20"
        android:textColor="#804000"
        android:textSize="36sp"
        app:layout_constraintBottom_toTopOf="@+id/dateName3"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground3"
        app:layout_constraintStart_toStartOf="@+id/dateBackground3"
        app:layout_constraintTop_toTopOf="@+id/dateBackground3"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/dateName3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUE"
        android:textColor="#804000"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@+id/dateBackground3"
        app:layout_constraintEnd_toEndOf="@+id/dateBackground3"
        app:layout_constraintStart_toStartOf="@+id/dateBackground3"
        app:layout_constraintTop_toBottomOf="@+id/date3" />

    <!-- Schedule Board Container -->
    <TextView
        android:id="@+id/scheduleBoard"
        android:layout_width="358dp"
        android:layout_height="400dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="70dp"
        android:background="@drawable/custom_square"
        android:backgroundTint="#06402B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dateBackground" />

    <!-- Schedule Board Header -->
    <TextView
        android:id="@+id/dateHeader"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/custom_square_2"
        android:backgroundTint="#804000"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toTopOf="@+id/scheduleBoard" />

    <TextView
        android:id="@+id/scheduleBoardHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="MONDAY SCHEDULE"
        android:textColor="#F6F6F6"
        android:textSize="22sp"
        app:layout_constraintBottom_toBottomOf="@+id/dateHeader"
        app:layout_constraintEnd_toEndOf="@+id/dateHeader"
        app:layout_constraintStart_toStartOf="@+id/dateHeader"
        app:layout_constraintTop_toTopOf="@+id/dateHeader" />

    <!-- Note -->
    <TextView
        android:id="@+id/mainSchedule"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="NOTE: Must be at school before 12:20."
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/dateHeader" />

    <!-- Table Column Headers -->
    <TextView
        android:id="@+id/timeHeader"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="TIME"
        android:textColor="#FFD59B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/mainSchedule" />

    <View
        android:id="@+id/verticalSeparator"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:background="#60FFFFFF"
        app:layout_constraintBottom_toBottomOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/timeHeader"
        app:layout_constraintTop_toTopOf="@+id/timeHeader"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/subjectHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="SUBJECT"
        android:textColor="#FFD59B"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timeHeader" />

    <!-- Row 1 -->
    <TextView
        android:id="@+id/timePeriod"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:text="12:40-1:30"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/timeHeader" />

    <TextView
        android:id="@+id/subject1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Computer Programming (Mr. Sixson)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod" />

    <!-- Row 2 -->
    <TextView
        android:id="@+id/timePeriod4"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="1:30-2:20"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/subject1" />

    <TextView
        android:id="@+id/subject2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="CLED 11-A (Mr. Barbero)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod4" />

    <!-- Row 3 -->
    <TextView
        android:id="@+id/timePeriod6"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="2:20-3:10"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/subject2" />

    <TextView
        android:id="@+id/subject3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="General Science (Ms. Torrefranca)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod6" />

    <!-- Row 4 (Break) -->
    <TextView
        android:id="@+id/timePeriod8"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="3:10-3:30"
        android:textColor="#FD9F00"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/subject3" />

    <TextView
        android:id="@+id/subject4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="HEALTH BREAK"
        android:textColor="#FD9F00"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod8" />

    <!-- Row 5 -->
    <TextView
        android:id="@+id/timePeriod9"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="3:30-4:20"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/subject4" />

    <TextView
        android:id="@+id/subject5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Effective Communication (Ms. Cruz)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod9" />

    <!-- Row 6 -->
    <TextView
        android:id="@+id/timePeriod10"
        android:layout_width="95dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="4:20-5:10"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@+id/scheduleBoard"
        app:layout_constraintTop_toBottomOf="@+id/subject5" />

    <TextView
        android:id="@+id/subject6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="Mabisang Komunikasyon (Mr. Royulada)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="@+id/scheduleBoard"
        app:layout_constraintStart_toEndOf="@+id/verticalSeparator"
        app:layout_constraintTop_toTopOf="@+id/timePeriod10" />

    <!-- Bottom Navigation Bar -->
    <TextView
        android:id="@+id/redirectShape"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/redirect_section"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/navHome"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="24dp"
        android:contentDescription="Home"
        android:src="@drawable/pixelated_house"
        app:layout_constraintBottom_toBottomOf="@+id/redirectShape"
        app:layout_constraintEnd_toStartOf="@+id/navChat"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/redirectShape"
        app:layout_constraintTop_toTopOf="@+id/redirectShape" />

    <ImageView
        android:id="@+id/navChat"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Chat"
        android:src="@drawable/pixelated_bubble_chat"
        app:layout_constraintBottom_toBottomOf="@+id/redirectShape"
        app:layout_constraintEnd_toStartOf="@+id/navSubjects"
        app:layout_constraintStart_toEndOf="@+id/navHome"
        app:layout_constraintTop_toTopOf="@+id/redirectShape" />

    <ImageView
        android:id="@+id/navSubjects"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Subjects"
        android:src="@drawable/pixelated_notebook"
        app:layout_constraintBottom_toBottomOf="@+id/redirectShape"
        app:layout_constraintEnd_toStartOf="@+id/navGrades"
        app:layout_constraintStart_toEndOf="@+id/navChat"
        app:layout_constraintTop_toTopOf="@+id/redirectShape" />

    <ImageView
        android:id="@+id/navGrades"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="Grades"
        android:src="@drawable/pixelated_exam_paper"
        app:layout_constraintBottom_toBottomOf="@+id/redirectShape"
        app:layout_constraintEnd_toStartOf="@+id/navSchedule"
        app:layout_constraintStart_toEndOf="@+id/navSubjects"
        app:layout_constraintTop_toTopOf="@+id/redirectShape" />

    <ImageView
        android:id="@+id/navSchedule"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="Schedule"
        android:src="@drawable/pixelated_calendar"
        app:layout_constraintBottom_toBottomOf="@+id/redirectShape"
        app:layout_constraintEnd_toEndOf="@+id/redirectShape"
        app:layout_constraintStart_toEndOf="@+id/navGrades"
        app:layout_constraintTop_toTopOf="@+id/redirectShape" />

</androidx.constraintlayout.widget.ConstraintLayout>
